   "title": "Pod belum siap",
   "description": "Pod yang berjalan tapi readiness probe-nya gagal.",
   "targets": [
    {
     "refId": "A",
     "expr": "sum(kube_pod_status_ready{condition=\"false\"} * on(namespace, pod) group_left() kube_pod_status_phase{phase=\"Running\"}) or vector(0)",

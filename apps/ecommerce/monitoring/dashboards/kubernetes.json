    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(kube_pod_info, namespace)",
     "refId": "ns"
    },
    "definition": "label_values(kube_pod_info, namespace)",
    "refresh": 2,
    "sort": 1,
    "includeAll": true,
    "multi": true,

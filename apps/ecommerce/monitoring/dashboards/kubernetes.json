  {
   "type": "stat",
   "title": "Pod berjalan",
   "description": "",
   "targets": [
    {
     "refId": "A",
     "expr": "sum(kube_pod_status_phase{phase=\"Running\"})",
     "instant": true,
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": null,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   },
   "id": 1,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"

  {
   "type": "row",
   "title": "Semua service sekaligus",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 24,
    "h": 1
   },
   "panels": [],
   "id": 15,
   "datasource": {

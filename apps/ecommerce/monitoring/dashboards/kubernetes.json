  {
   "type": "table",
   "title": "Ringkasan per service",
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 24,
    "h": 12
   },
   "description": "Satu baris per namespace (satu service atau tool). CPU dalam core. % limit memori mendekati 100 berarti container bisa OOMKilled. Jaringan tidak dihitung untuk Pod yang memakai jaringan server langsung (hostNetwork), karena angkanya trafik seluruh server.",
   "targets": [
    {
     "refId": "CPU",
     "expr": "sum by (namespace) (rate(container_cpu_usage_seconds_total{container!=\"\", namespace!~\"kube-.*\"}[5m]))",
     "instant": true,
     "format": "table",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "REQ",
     "expr": "sum by (namespace) (kube_pod_container_resource_requests{resource=\"cpu\", namespace!~\"kube-.*\"})",
     "instant": true,
     "format": "table",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "MEM",
     "expr": "sum by (namespace) (container_memory_working_set_bytes{container!=\"\", namespace!~\"kube-.*\"})",
     "instant": true,
     "format": "table",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "LIM",
     "expr": "round(100 * sum by (namespace) (container_memory_working_set_bytes{container!=\"\", namespace!~\"kube-.*\"}) / sum by (namespace) (kube_pod_container_resource_limits{resource=\"memory\", namespace!~\"kube-.*\"}), 0.1)",
     "instant": true,
     "format": "table",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "RX",
     "expr": "sum by (namespace) (rate(container_network_receive_bytes_total{namespace!~\"|kube-.*\"}[5m]) unless on(namespace, pod) kube_pod_info{host_network=\"true\"})",
     "instant": true,
     "format": "table",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "TX",
     "expr": "sum by (namespace) (rate(container_network_transmit_bytes_total{namespace!~\"|kube-.*\"}[5m]) unless on(namespace, pod) kube_pod_info{host_network=\"true\"})",
     "instant": true,
     "format": "table",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "RST",
     "expr": "round(sum by (namespace) (increase(kube_pod_container_status_restarts_total{namespace!~\"kube-.*\"}[24h])))",
     "instant": true,
     "format": "table",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "transformations": [
    {
     "id": "joinByField",
     "options": {
      "byField": "namespace",
      "mode": "outer"
     }
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "Time 1": true,
       "Time 2": true,
       "Time 3": true,
       "Time 4": true,
       "Time 5": true,
       "Time 6": true,
       "Time 7": true
      },
      "renameByName": {
       "Value #CPU": "CPU",
       "Value #REQ": "CPU request",
       "Value #MEM": "Memori",
       "Value #LIM": "% limit memori",
       "Value #RX": "Jaringan masuk",
       "Value #TX": "Jaringan keluar",
       "Value #RST": "Restart 24 jam"
      },
      "indexByName": {
       "namespace": 0,
       "Value #CPU": 1,
       "Value #REQ": 2,
       "Value #MEM": 3,
       "Value #LIM": 4,
       "Value #RX": 5,
       "Value #TX": 6,
       "Value #RST": 7
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 2
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Memori"
      },
      "properties": [
       {
        "id": "unit",
        "value": "bytes"
       },
       {
        "id": "decimals",
        "value": 0
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "% limit memori"
      },
      "properties": [
       {
        "id": "unit",
        "value": "percent"
       },
       {
        "id": "decimals",
        "value": 1
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background"
        }
       },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "green",
           "value": null
          },
          {
           "color": "orange",
           "value": 75
          },
          {
           "color": "red",
           "value": 90
          }
         ]
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Jaringan masuk"
      },
      "properties": [
       {
        "id": "unit",
        "value": "Bps"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Jaringan keluar"
      },
      "properties": [
       {
        "id": "unit",
        "value": "Bps"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Restart 24 jam"
      },
      "properties": [
       {
        "id": "decimals",
        "value": 0
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "text",
           "value": null
          },
          {
           "color": "red",
           "value": 1
          }
         ]
        }
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "sortBy": [
     {
      "displayName": "Memori",
      "desc": true
     }
    ]
   },
   "id": 16,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   }
  },

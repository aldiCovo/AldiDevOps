  },
  {
   "type": "stat",
   "title": "Error 5xx",
   "description": "Bagian request yang dijawab dengan error server, 5 menit terakhir.",
   "targets": [
    {
     "refId": "A",
     "expr": "100 * (sum(rate(http_requests_total{job=\"pods\",namespace!=\"saham\",route!~\"GET /(healthz|readyz)\",code=~\"5..\"}[5m])) or vector(0)) / clamp_min(sum(rate(http_requests_total{job=\"pods\",namespace!=\"saham\",route!~\"GET /(healthz|readyz)\"}[5m])) or vector(0), 1e-9)",
     "instant": true,
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "decimals": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       },
       {
        "color": "red",
        "value": 5
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   },
   "id": 2,

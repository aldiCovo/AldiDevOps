  {
   "type": "stat",
   "title": "Request / detik",
   "description": "Semua service, tanpa health check.",
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(http_requests_total{job=\"pods\",namespace!=\"saham\",route!~\"GET /(healthz|readyz)\"}[5m]))",
     "instant": true,
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "decimals": null,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   },
   "id": 1,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"

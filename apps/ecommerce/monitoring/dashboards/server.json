  {
   "type": "timeseries",
   "title": "Baca / tulis disk",
   "description": "Tulis digambar di bawah nol.",
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(node_disk_read_bytes_total{instance=\"aldiserver\"}[5m]))",
     "legendFormat": "baca",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "B",
     "expr": "-sum(rate(node_disk_written_bytes_total{instance=\"aldiserver\"}[5m]))",
     "legendFormat": "tulis",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "Bps",
     "custom": {
      "fillOpacity": 10,
      "lineWidth": 1,
      "stacking": {

{
 "uid": "aldiserver",
 "title": "Server",
 "description": "CPU, memori, disk, dan jaringan AldiServer dari node-exporter.",
 "tags": [
  "aldiserver"
 ],
 "timezone": "browser",
 "schemaVersion": 41,
 "version": 1,
 "editable": false,
 "graphTooltip": 1,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "templating": {
  "list": []
 },
 "annotations": {
  "list": []
 },
 "panels": [
  {
   "type": "stat",
   "title": "CPU",
   "description": "Rata-rata pemakaian semua core dalam 5 menit terakhir.",
   "targets": [
    {
     "refId": "A",
     "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{instance=\"aldiserver\",mode=\"idle\"}[5m])))",
     "instant": true,
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "decimals": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 70
       },
       {
        "color": "red",
        "value": 90
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   },
   "id": 1,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   }
  },
  {
   "type": "stat",
   "title": "Memori",
   "description": "Memori yang tidak bisa dipakai lagi. Cache yang bisa dilepas dihitung tersedia.",
   "targets": [
    {
     "refId": "A",
     "expr": "100 * (1 - node_memory_MemAvailable_bytes{instance=\"aldiserver\"} / node_memory_MemTotal_bytes{instance=\"aldiserver\"})",
     "instant": true,
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "decimals": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 80
       },
       {
        "color": "red",
        "value": 92
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   },
   "id": 2,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 4
   }
  },
  {
   "type": "stat",
   "title": "Disk /",
   "description": "Isi partisi root, tempat /var/lib/aldi.",
   "targets": [
    {
     "refId": "A",
     "expr": "100 * (1 - node_filesystem_avail_bytes{instance=\"aldiserver\",mountpoint=\"/\",fstype!=\"rootfs\"} / node_filesystem_size_bytes{instance=\"aldiserver\",mountpoint=\"/\",fstype!=\"rootfs\"})",
     "instant": true,
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "decimals": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 75
       },
       {
        "color": "red",
        "value": 90
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   },
   "id": 3,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 4,
    "h": 4
   }
  },
  {
   "type": "stat",
   "title": "Load / core",
   "description": "Load rata-rata 5 menit dibagi jumlah core. Di atas 1 berarti ada proses yang menunggu CPU.",
   "targets": [
    {
     "refId": "A",
     "expr": "node_load5{instance=\"aldiserver\"} / count(node_cpu_seconds_total{instance=\"aldiserver\",mode=\"idle\"})",
     "instant": true,
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": null,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       },
       {
        "color": "red",
        "value": 2
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   },
   "id": 4,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 4,
    "h": 4
   }
  },
  {
   "type": "stat",
   "title": "Uptime",
   "description": "Sejak server terakhir dinyalakan.",
   "targets": [
    {
     "refId": "A",
     "expr": "time() - node_boot_time_seconds{instance=\"aldiserver\"}",
     "instant": true,
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "decimals": null,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",

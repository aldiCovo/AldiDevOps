  {
   "type": "row",
   "title": "CPU dan memori",
   "id": 7,
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "CPU per mode",
   "description": "Bagian waktu CPU yang dipakai, per jenis kerja. iowait tinggi berarti menunggu disk.",
   "targets": [
    {
     "refId": "A",
     "expr": "100 * sum by (mode) (rate(node_cpu_seconds_total{instance=\"aldiserver\",mode!=\"idle\"}[5m])) / scalar(count(node_cpu_seconds_total{instance=\"aldiserver\",mode=\"idle\"}))",
     "legendFormat": "{{mode}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "fillOpacity": 25,
      "lineWidth": 1,
      "stacking": {
       "mode": "normal"
      }
     },
     "max": 100
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "max"
     ],
     "sortBy": "Last *",
     "sortDesc": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "id": 8,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 12,
    "h": 8
   }
  },
  {
   "type": "timeseries",
   "title": "Memori",
   "description": "Terpakai ditambah tersedia sama dengan total RAM.",
   "targets": [
    {
     "refId": "A",
     "expr": "node_memory_MemTotal_bytes{instance=\"aldiserver\"} - node_memory_MemAvailable_bytes{instance=\"aldiserver\"}",
     "legendFormat": "terpakai",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "B",
     "expr": "node_memory_MemAvailable_bytes{instance=\"aldiserver\"}",
     "legendFormat": "tersedia",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "fillOpacity": 25,

  {
   "type": "stat",
   "title": "Core CPU",
   "description": "Jumlah core CPU.",
   "targets": [
    {
     "refId": "A",
     "expr": "count(node_cpu_seconds_total{instance=\"aldiserver\",mode=\"idle\"})",
     "instant": true,
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {

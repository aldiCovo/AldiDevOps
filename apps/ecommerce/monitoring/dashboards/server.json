  {
   "type": "timeseries",
   "title": "Jaringan",
   "description": "Keluar digambar di bawah nol. Interface Pod tidak dihitung.",
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (device) (rate(node_network_receive_bytes_total{instance=\"aldiserver\"}[5m]))",
     "legendFormat": "masuk {{device}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "B",
     "expr": "-sum by (device) (rate(node_network_transmit_bytes_total{instance=\"aldiserver\"}[5m]))",

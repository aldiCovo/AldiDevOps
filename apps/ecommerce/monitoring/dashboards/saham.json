{
 "uid": "saham",
 "title": "Saham",
 "description": "Job harian, halaman web, database dan log aplikasi saham.",
 "tags": [
  "aldiserver"
 ],
 "timezone": "browser",
 "schemaVersion": 41,
 "version": 1,
 "editable": false,
 "graphTooltip": 1,

  {
   "type": "timeseries",
   "title": "Run per hasil",
   "description": "ok: brief terkirim; skipped: hari libur atau sudah jalan; error: gagal, dicoba lagi.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (result) (increase(saham_job_runs_total{namespace=\"saham\"}[1h]))",
     "legendFormat": "{{result}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "interval": "1h"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {
      "fillOpacity": 80,
      "lineWidth": 1,
      "stacking": {
       "mode": "normal"
      },
      "drawStyle": "bars"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "sum"
     ],
     "sortBy": "Total",
     "sortDesc": true
